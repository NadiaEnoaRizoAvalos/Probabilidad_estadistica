{
  "name": "probabilidad-estadistica",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "test": "vitest run",
    "preview": "vite preview --host 127.0.0.1",
    "test:e2e": "npm run build && playwright test",
    "sync:notion": "node scripts/sync-notion.ts",
    "validate:theory": "node scripts/validate-theory.ts",
    "check:sync": "tsc -p tsconfig.sync.json",
    "typecheck": "tsc --noEmit && npm run check:sync",
    "validate:exams": "node scripts/validate-exams.ts"
  },
  "dependencies": {
    "lucide-react": "^1.73.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5",
    "katex": "^0.16.22"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@notionhq/client": "^5.31.1",
    "@playwright/test": "^1.65.1",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0",
    "@types/katex": "^0.16.7"
  },
  "overrides": {
    "@typescript-eslint/typescript-estree": {
      "minimatch": "^11.0.1"
    }
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
